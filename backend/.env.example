# Environment Configuration Example
PROJECT_NAME="Mini Employee Management System"
API_V1_STR="/api/v1"

# Database Configuration
# For MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# For local SQLite fallback (zero configuration required): sqlite:///./employee_management.db
DATABASE_URL=sqlite:///./employee_management.db

# JWT & Security Configuration
# Generate a secure key in production using: openssl rand -hex 32
SECRET_KEY=super-secret-jwt-token-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-app.vercel.app

# Initial Admin Credentials (used during automatic seed)
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=admin123

